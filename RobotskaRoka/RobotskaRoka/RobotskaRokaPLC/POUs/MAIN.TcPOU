  <POU Name="MAIN" Id="{26f6676c-871c-4b33-aa99-0c46ab4a81a1}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    bManualMode AT %I* : BOOL;
    bRotateLeft AT %I* : BOOL;
    bRotateRight AT %I* : BOOL;
    bExtend AT %I* : BOOL;
    bRetract AT %I* : BOOL;
    bShift AT %I* : BOOL;
    bStopButton AT %I* : BOOL;

    bRotateLimit AT %I* : BOOL;
    bExtendLimit AT %I* : BOOL;
    bLiftLimit AT %I* : BOOL;
    bGripLimit AT %I* : BOOL;
	
	bAllButtonsReleased : BOOL;
	bShiftSelected : BOOL;
	bShiftMismatch : BOOL;
	bCommandArmed : BOOL;
	bMotionEnabled : BOOL;

    bRotateLeftCmd : BOOL;
    bRotateRightCmd : BOOL;
    bExtendCmd : BOOL;
    bRetractCmd : BOOL;
    bLiftUp : BOOL;
    bLiftDown : BOOL;
    bGripOpen : BOOL;
    bGripClose : BOOL;

    bReqRotateForward : BOOL;
    bReqRotateBackward : BOOL;
    bReqExtendForward : BOOL;
    bReqExtendBackward : BOOL;
    bReqLiftForward : BOOL;
    bReqLiftBackward : BOOL;
    bReqGripForward : BOOL;
    bReqGripBackward : BOOL;

    bRotateRun AT %Q* : BOOL;
    bRotateDirection AT %Q* : BOOL;

    bExtendRun AT %Q* : BOOL;
    bExtendDirection AT %Q* : BOOL;

    bLiftRun AT %Q* : BOOL;
    bLiftDirection AT %Q* : BOOL;

    bGripRun AT %Q* : BOOL;
    bGripDirection AT %Q* : BOOL;


    fbRotateSelector : FB_CommandSelector;
    fbExtendSelector : FB_CommandSelector;
    fbLiftSelector : FB_CommandSelector;
    fbGripSelector : FB_CommandSelector;


    fbRotateMotor : FB_MotorControl;
    fbExtendMotor : FB_MotorControl;
    fbLiftMotor : FB_MotorControl;
    fbGripMotor : FB_MotorControl;
END_VAR
]]></Declaration>
